# Supabase — anon key is safe for the browser; never ship the service role to clients
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Server-only (rate limit RPC, usage_logs); keep secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Gemini (server-only; restart `next dev` after changing `.env.local`)
GEMINI_API_KEY=your_gemini_api_key
# Optional: set to 1 to print GEMINI_API_KEY presence/length in production API logs
# DEBUG_GEMINI_ENV=1
# Optional model override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Rate limit: max generation attempts per client IP per rolling minute bucket
# (applied after request validation, before calling Gemini; see docs/listing-optimizer.md)
RATE_LIMIT_MAX=10

# --- Feature flags (optional; overrides Supabase `feature_flags` when set) ---
# NEXT_PUBLIC_FF_KEYWORD_TRACKER=true
# NEXT_PUBLIC_FF_LISTING_OPTIMIZER=true
# NEXT_PUBLIC_FF_RANKING_TRACKER_ADVANCED=false

# --- Error monitoring (optional) ---
# Server + edge: use Sentry project DSN (keep secret on non-Vercel hosts)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Browser: same DSN is acceptable for client SDK; restrict allowed domains in Sentry project settings
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# --- Serper.dev (optional — live Play Store SERP previews) ---
# Server-only Google Search API key. Used by `lib/serper.ts` and `POST /api/serper/play-store-search`
# to power the per-country Play Store preview in Keyword Tracker / Competitor Spy.
# Get one at https://serper.dev — leave blank to keep demo/mock data instead.
# SERPER_API_KEY=your_serper_api_key

# --- Runware (optional — AI app icon batch in Listing Optimizer) ---
# RUNWARE_API_KEY=your_runware_api_key
# Optional overrides (defaults: https://api.runware.ai/v1 and FLUX Schnell runware:100@1)
# RUNWARE_API_URL=https://api.runware.ai/v1
# RUNWARE_MODEL=runware:100@1

# --- Admin routes (`/[locale]/admin/*`) ---
# Comma-separated sign-in emails allowed as admins when non-empty. Matching is case-insensitive.
# If unset or blank, only `profiles.role = 'admin'` or `profiles.is_admin` (DB) grants access.
# If set, access when email is on this list OR DB admin flags (either is enough).
# Immediate access without waiting on DB role updates: set your sign-in email here (no JWT custom claims required).
# ADMIN_EMAILS=syedmairaj@yahoo.com
# ADMIN_EMAILS=you@example.com,other@example.com
# Note: `admin_financial_snapshot` allows `profiles.role = 'admin'` or `profiles.is_admin` (see migrations).

# --- Admin financial dashboard (optional) ---
# Prorated over the chart window (≈ last 30 days): (MONTHLY_SERVER_COST_USD / 30) * dayCount
# MONTHLY_SERVER_COST_USD=0
