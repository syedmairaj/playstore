# Supabase — anon key is safe for the browser; never ship the service role to clients
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Server-only (rate limit RPC, usage_logs); keep secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Rate limit: max generation attempts per client IP per rolling minute bucket
# (applied after request validation, before calling Gemini; see docs/listing-optimizer.md)
RATE_LIMIT_MAX=10

# --- Feature flags (optional; overrides Supabase `feature_flags` when set) ---
# NEXT_PUBLIC_FF_KEYWORD_TRACKER=true
# NEXT_PUBLIC_FF_LISTING_OPTIMIZER=true
# NEXT_PUBLIC_FF_RANKING_TRACKER_ADVANCED=false

# --- Error monitoring (optional) ---
# Server + edge: use Sentry project DSN (keep secret on non-Vercel hosts)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Browser: same DSN is acceptable for client SDK; restrict allowed domains in Sentry project settings
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
